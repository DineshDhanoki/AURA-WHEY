{
  "headers": [
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/static/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/api/track-order/cancel", "destination": "/api/track-order-cancel" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/quality", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/article/:slug", "destination": "/index.html" },
    { "source": "/verify", "destination": "/index.html" },
    { "source": "/track-order", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/policy", "destination": "/index.html" },
    { "source": "/document", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" }
  ]
}
